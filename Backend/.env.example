PORT=5000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=murakaza_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (for password reset links)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# MTN Mobile Money (MoMo Collections API)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_MOMO_API_USER=your_mtn_api_user
MTN_MOMO_API_KEY=your_mtn_api_key
MTN_MOMO_TARGET_ENV=sandbox

# Tigo Cash — get real base URL/credentials from your supervisor once
# registered as a merchant.
TIGO_CASH_BASE_URL=
TIGO_CASH_API_KEY=
TIGO_CASH_MERCHANT_ID=

# IremboPay
IREMBOPAY_BASE_URL=https://api.irembopay.com
IREMBOPAY_SECRET_KEY=your_irembopay_secret_key
IREMBOPAY_ACCOUNT_ID=your_irembopay_account_id

# Flutterwave
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key

# Default admin, seeded automatically on server start (Backend/routes/create_admin.js)
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@murakaza.com
DEFAULT_ADMIN_PHONE=0780000000
DEFAULT_ADMIN_PASSWORD=Admin@123

# Staff accounts, seeded by running: node database/seed-staff.js
CASHIER_NAME=Cashier
CASHIER_EMAIL=cashier@murakaza.com
CASHIER_PHONE=0781000001
CASHIER_PASSWORD=Cashier@123

STOREKEEPER_NAME=Storekeeper
STOREKEEPER_EMAIL=storekeeper@murakaza.com
STOREKEEPER_PHONE=0781000002
STOREKEEPER_PASSWORD=Storekeeper@123

MANAGER_NAME=Manager
MANAGER_EMAIL=manager@murakaza.com
MANAGER_PHONE=0781000003
MANAGER_PASSWORD=Manager@123